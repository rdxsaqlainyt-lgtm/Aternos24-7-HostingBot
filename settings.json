const mineflayer = require('mineflayer')

function createBot() {
  const bot = mineflayer.createBot({
    host: 'BlossomVillesmp12.aternos.me',
    port: 36029,
    username: 'Ap_Bas_Khelo',
    version: '1.16.5'
  })

  function random(min, max) {
    return Math.random() * (max - min) + min
  }

  function randomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min
  }

  function resetControls() {
    const keys = ['forward','back','left','right','jump','sprint','sneak']
    keys.forEach(k => bot.setControlState(k, false))
  }

  function smoothLook() {
    const yaw = bot.entity.yaw + random(-0.8, 0.8)
    const pitch = bot.entity.pitch + random(-0.2, 0.2)
    bot.look(yaw, pitch, true)
  }

  function randomMovement() {
    resetControls()
    const actions = [
      () => bot.setControlState('forward', true),
      () => bot.setControlState('back', true),
      () => bot.setControlState('left', true),
      () => bot.setControlState('right', true),
      () => bot.setControlState('jump', true),
      () => bot.setControlState('sneak', true),
      () => {
        bot.setControlState('forward', true)
        bot.setControlState('sprint', true)
      },
      () => {} // idle
    ]
    actions[randomInt(0, actions.length - 1)]()
  }

  function creativeFloat() {
    if (bot.game.gameMode !== 1) return
    const up = random(-0.05, 0.05)
    bot.entity.position.y += up
  }

  function randomHotbarSwitch() {
    const slot = randomInt(0, 8)
    bot.setQuickBarSlot(slot)
  }

  function humanBehaviorLoop() {
    smoothLook()
    randomMovement()
    creativeFloat()
    if (Math.random() < 0.2) randomHotbarSwitch()
    setTimeout(humanBehaviorLoop, randomInt(2000, 6000))
  }

  // AuthMe handling
  bot.on('messagestr', (msg) => {
    if (msg.includes('Please login')) {
      bot.chat('/login hey1234')
    }
    if (msg.includes('Please register')) {
      bot.chat('/register hey1234 hey1234')
    }
  })

  bot.once('spawn', () => {
    console.log('Ultra realistic human AFK started.')
    // Optional: force login after short delay
    setTimeout(() => {
      bot.chat('/login hey1234')
    }, 3000)
    humanBehaviorLoop()
  })

  bot.on('end', () => {
    console.log('Disconnected. Reconnecting...')
    setTimeout(createBot, 20000)
  })

  bot.on('error', err => console.log('Error:', err))
}

createBot()
